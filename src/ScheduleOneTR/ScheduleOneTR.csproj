<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Schedule I - Türkçe Çeviri Yaması (MelonLoader modu)

    Derleme:
      IL2CPP (Steam ana dal / default branch):
        dotnet build -c IL2CPP -p:GameDir="C:\Program Files (x86)\Steam\steamapps\common\Schedule I"
      Mono (Steam "alternate" dalı):
        dotnet build -c Mono   -p:GameDir="C:\Program Files (x86)\Steam\steamapps\common\Schedule I"

    GameDir'i her seferinde yazmak istemiyorsan src/ScheduleOneTR/Directory.Build.props
    dosyasına <GameDir>...</GameDir> ekle (örnek dosya: Directory.Build.props.example).
  -->

  <PropertyGroup>
    <Configurations>IL2CPP;Mono</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">IL2CPP</Configuration>
    <AssemblyName Condition="'$(Configuration)' == 'IL2CPP'">ScheduleOneTR_Il2Cpp</AssemblyName>
    <AssemblyName Condition="'$(Configuration)' == 'Mono'">ScheduleOneTR_Mono</AssemblyName>
    <RootNamespace>ScheduleOneTR</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Oyunun/MelonLoader'ın DLL'lerini çıktıya kopyalamıyoruz -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8632</NoWarn>
  </PropertyGroup>

  <!-- IL2CPP: MelonLoader 0.7.x net6 çalışma zamanı -->
  <PropertyGroup Condition="'$(Configuration)' == 'IL2CPP'">
    <TargetFramework>net6.0</TargetFramework>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <MlDir>$(GameDir)\MelonLoader\net6</MlDir>
    <GameAsmDir>$(GameDir)\MelonLoader\Il2CppAssemblies</GameAsmDir>
  </PropertyGroup>

  <!-- Mono: klasik .NET Framework hedefi -->
  <PropertyGroup Condition="'$(Configuration)' == 'Mono'">
    <TargetFramework>net472</TargetFramework>
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    <MlDir>$(GameDir)\MelonLoader\net35</MlDir>
    <GameAsmDir>$(GameDir)\Schedule I_Data\Managed</GameAsmDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
  </ItemGroup>

  <!--
    Referansları joker ile alıyoruz. Nedeni: MelonLoader'ın IL2CPP için ürettiği
    assembly adları sürümden sürüme değişiyor (Il2CppTMPro / Il2CppUnity.TextMeshPro
    gibi). Tek tek yazmak yerine klasörün tamamını referanslıyoruz; eksik DLL yüzünden
    derleme patlamıyor.
  -->
  <ItemGroup>
    <_MlRef Include="$(MlDir)\MelonLoader.dll" />
    <_MlRef Include="$(MlDir)\0Harmony.dll" />
    <_MlRef Include="$(MlDir)\Il2CppInterop.Runtime.dll" Condition="'$(Configuration)' == 'IL2CPP'" />
    <_MlRef Include="$(MlDir)\Il2CppInterop.Common.dll" Condition="'$(Configuration)' == 'IL2CPP'" />

    <_GameRef Include="$(GameAsmDir)\*.dll"
              Exclude="$(GameAsmDir)\netstandard.dll;$(GameAsmDir)\mscorlib.dll;$(GameAsmDir)\System*.dll" />

    <Reference Include="@(_MlRef)">
      <Private>false</Private>
      <HintPath>%(Identity)</HintPath>
    </Reference>
    <Reference Include="@(_GameRef)">
      <Private>false</Private>
      <HintPath>%(Identity)</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(GameDir)' == ''"
           Text="GameDir tanımlı değil. Örnek: dotnet build -c $(Configuration) -p:GameDir=&quot;C:\Program Files (x86)\Steam\steamapps\common\Schedule I&quot;" />
    <Error Condition="!Exists('$(GameDir)')"
           Text="GameDir bulunamadı: $(GameDir)" />
    <Error Condition="!Exists('$(MlDir)\MelonLoader.dll')"
           Text="MelonLoader bulunamadı: $(MlDir)\MelonLoader.dll — Oyunu bir kez MelonLoader ile başlatıp assembly'lerin üretilmesini bekle." />
  </Target>

  <!-- Derleme sonrası otomatik kurulum: -p:DeployToGame=true -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <!-- languages/<klasor>/*.txt -> UserData\ScheduleOneTR\languages\<klasor>\ -->
      <_LangFiles Include="$(MSBuildThisFileDirectory)..\..\languages\**\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
    <Copy SourceFiles="@(_LangFiles)"
          DestinationFiles="@(_LangFiles->'$(GameDir)\UserData\ScheduleOneTR\languages\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Kuruldu -> $(GameDir)\Mods\$(TargetFileName)" />
    <Message Importance="high" Text="Dil dosyasi: @(_LangFiles->Count()) adet -> $(GameDir)\UserData\ScheduleOneTR\languages\" />
  </Target>

</Project>
